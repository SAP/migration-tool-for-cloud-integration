{
    "name": "migrationtasks",
    "version": "1.0.0",
    "description": "CPI Migration Tool: Migration Tasks",
    "keywords": [],
    "main": "webapp/index.html",
    "scripts": {
        "lint": "eslint webapp",
        "ui5lint": "ui5lint",
        "ts-typecheck": "tsc --noEmit",
        "validate": "npm run lint && npm run ui5lint && npm run ts-typecheck",
        "build": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo"
    },
    "devDependencies": {
        "@eslint/js": "^10.0",
        "@sapui5/types": "^1.150",
        "@ui5/linter": "^1.23",
        "eslint": "^10.7",
        "globals": "^17.7",
        "typescript": "^6.0",
        "typescript-eslint": "^8.65",
        "ui5-task-zipper": "^3.6",
        "ui5-tooling-transpile": "^3.12"
    },
    "peerDependencies": {
        "@ui5/cli": ">=4",
        "mbt": ">=1"
    }
}
